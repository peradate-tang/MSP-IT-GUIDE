DATABASE_URL=mysql://user:password@host:3306/database_name
JWT_SECRET=your-super-secret-jwt-key-change-this
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://your-frontend.up.railway.app

# ตั้งค่าเหล่านี้เพื่อเปิดใช้งานฟีเจอร์ "ลืมรหัสผ่าน" (ส่งอีเมลลิงก์รีเซ็ต)
# ถ้าไม่ตั้งค่า ระบบยังรันได้ปกติ แค่ endpoint /auth/forgot-password จะแจ้งว่ายังไม่พร้อมใช้งาน
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Staff Guide <no-reply@yourhotel.com>
